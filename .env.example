# local = retrieval vetorial determinístico + resposta extrativa (CI/offline)
# ollama = embeddings semânticos + geração local por LLM (RAG generativo)
RAG_MODE=local
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_EMBED_MODEL=nomic-embed-text
OLLAMA_CHAT_MODEL=qwen3:0.6b
RAG_TOP_K=5
RAG_MIN_SCORE=0.12
