# local = retrieval vetorial determinístico + resposta extrativa (CI/offline)
# ollama = embeddings semânticos + geração local por LLM (RAG generativo)
RAG_MODE=local
OLLAMA_BASE_URL=http://127.0.0.1:11434
# Multilíngue (padrão). Alternativas: embeddinggemma (mais leve), bge-m3 (GPU). Prefixos de tarefa são automáticos.
OLLAMA_EMBED_MODEL=nomic-embed-text-v2-moe
OLLAMA_CHAT_MODEL=qwen3:0.6b
# Timeouts (segundos, 1..600) das chamadas ao Ollama e tamanho do lote de indexação (1..256)
OLLAMA_EMBED_TIMEOUT_S=30
OLLAMA_GENERATE_TIMEOUT_S=60
OLLAMA_EMBED_BATCH_SIZE=32
# Faixas aceitas: RAG_TOP_K 1..50, RAG_MIN_SCORE 0..1 (valores fora da faixa impedem o boot)
RAG_TOP_K=5
RAG_MIN_SCORE=0.12
# Cosseno mínimo para aceitar um trecho sem nenhum termo em comum com a pergunta (0..1)
RAG_VECTOR_ONLY_MIN_SCORE=0.5

# Observabilidade
# LOG_LEVEL: DEBUG | INFO | WARNING | ERROR (DEBUG inclui pergunta/resposta em texto e requisições a /health)
# LOG_FORMAT: json (uma linha JSON por evento, para produção) | text (legível, para desenvolvimento)
LOG_LEVEL=INFO
LOG_FORMAT=json
