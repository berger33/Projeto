# local = retrieval vetorial determinístico + resposta extrativa (CI/offline)
# ollama = embeddings semânticos + geração local por LLM (RAG generativo)
RAG_MODE=local
OLLAMA_BASE_URL=http://127.0.0.1:11434
# Multilíngue (padrão). Alternativas: embeddinggemma (mais leve), bge-m3 (GPU). Prefixos de tarefa são automáticos.
OLLAMA_EMBED_MODEL=nomic-embed-text-v2-moe
# Menor modelo com recusa fundamentada em PT-BR em CPU; qwen3:4b se houver ~8 GB livres
OLLAMA_CHAT_MODEL=qwen3:1.7b
# Timeouts (segundos, 1..600) das chamadas ao Ollama e tamanho do lote de indexação (1..256)
OLLAMA_EMBED_TIMEOUT_S=30
OLLAMA_GENERATE_TIMEOUT_S=60
OLLAMA_EMBED_BATCH_SIZE=32
# Janela de contexto (1024..131072) e máximo de tokens gerados (32..4096); o prompt usa num_ctx - num_predict - 64
OLLAMA_NUM_CTX=4096
OLLAMA_NUM_PREDICT=300
# RAG_TOP_K 1..50 (valores fora da faixa impedem o boot)
RAG_TOP_K=5
# Limiares: por padrão vêm do perfil do modo (local / ollama; ver README "Limiares por provider").
# Descomente para sobrescrever individualmente (0..1). Calibre com `python -m evals.calibrate --mode <modo>`.
# RAG_MIN_SCORE=0.12
# RAG_VECTOR_ONLY_MIN_SCORE=0.5
# RAG_VECTOR_WITH_OVERLAP_MIN_SCORE=0.35
# RAG_MIN_LEXICAL_COVERAGE=0.2
# RAG_HIGH_CONFIDENCE_SCORE=0.45
# RAG_RELATIVE_GAP=0.15
# RAG_MMR_LAMBDA=1.0            # diversificação MMR (1 = desligada); perfil ollama usa 0.7
# Reranker opcional: noop (padrão)
# RAG_RERANKER=noop

# Observabilidade
# LOG_LEVEL: DEBUG | INFO | WARNING | ERROR (DEBUG inclui pergunta/resposta em texto e requisições a /health)
# LOG_FORMAT: json (uma linha JSON por evento, para produção) | text (legível, para desenvolvimento)
LOG_LEVEL=INFO
LOG_FORMAT=json

# Índice persistido (.npy + manifest.json). Vazio desliga a persistência (reembeda a cada boot).
RAG_INDEX_DIR=.rag_index
